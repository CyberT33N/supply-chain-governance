{
  "schemaVersion": 4,
  "toolchain": { "language": "go", "version": "1.26.6" },
  "extends": [],
  "gates": [
    {
      "name": "supply-chain-governance-source-quality",
      "command": "go",
      "args": [
        "tool",
        "-modfile",
        "tools/go.mod",
        "quality-gate"
      ],
      "timeout": "15m"
    },
    {
      "name": "conformance-vectors",
      "command": "go",
      "args": [
        "run",
        "-mod=readonly",
        "./cmd/check-conformance"
      ],
      "timeout": "5m"
    }
  ],
  "project": {
    "binaries": [
      {
        "package": "./cmd/check-conformance",
        "smoke": ["--version"]
      }
    ],
    "fuzz": [
      {
        "package": "./internal/evidencegraph",
        "target": "FuzzParseDocument",
        "time": "50000x"
      },
      {
        "package": "./internal/dependencypolicy",
        "target": "FuzzParsePolicy",
        "time": "50000x"
      },
      {
        "package": "./internal/capabilitypack",
        "target": "FuzzParsePack",
        "time": "50000x"
      },
      {
        "package": "./internal/qualitygateconfig",
        "target": "FuzzParseConfig",
        "time": "50000x"
      }
    ]
  }
}
