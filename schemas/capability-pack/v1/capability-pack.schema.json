{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t33n-software/supply-chain-governance/schemas/capability-pack/v1/capability-pack.schema.json",
  "title": "capability-pack/v1 document",
  "description": "Canonical capability-pack/v1 descriptor: one versioned, schema-bound unit of shared gate behavior that tenants declare through the extends list of the quality-gate configuration seam. Provisioning is always a digest-verified recipe, and gate names are always prefixed by the capability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capability", "area", "version", "summary", "provisioning", "discovery", "assertions", "gates"],
  "properties": {
    "schema": {
      "const": "capability-pack/v1"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "area": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tool", "version", "environment", "artifacts"],
      "properties": {
        "kind": {
          "const": "recipe"
        },
        "tool": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
          "description": "The fleet-governed pinned tool version."
        },
        "environment": {
          "type": "object",
          "description": "Environment enforced for the pack's provisioning and gates.",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {"type": "string"}
        },
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "description": "Release artifacts keyed by <goos>-<goarch>, each digest-bound.",
          "propertyNames": {
            "pattern": "^[a-z0-9]+-[a-z0-9]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "sha256"],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "signature": {
                "type": "string",
                "minLength": 1,
                "description": "The signature reference where the publisher signs the artifact."
              }
            }
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "excludeDirs"],
      "properties": {
        "roots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileGlob"],
          "properties": {
            "fileGlob": {
              "type": "string",
              "minLength": 1,
              "description": "The glob whose parent directories form the per-root set."
            }
          }
        },
        "excludeDirs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "assertions": {
      "type": "array",
      "description": "Fail-closed environment proofs executed before any pack gate.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "args", "expect"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {"type": "string"}
          },
          "expect": {
            "type": "string",
            "minLength": 1,
            "description": "The output proof the assertion requires."
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "description": "The pack's gates; every name is lowercase kebab prefixed by the capability.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "args", "scope"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {"type": "string"}
          },
          "scope": {
            "enum": ["repository", "per-root"]
          },
          "timeout": {
            "type": "string",
            "description": "An optional positive Go duration such as 5m."
          }
        }
      }
    }
  }
}
