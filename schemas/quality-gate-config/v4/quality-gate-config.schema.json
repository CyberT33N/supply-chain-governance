{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t33n-software/supply-chain-governance/schemas/quality-gate-config/v4/quality-gate-config.schema.json",
  "title": "quality-gate-config/v4 document",
  "description": "Canonical quality-gate-config/v4 seam: the tenant's quality gate configuration with the language-keyed pinned toolchain identity, the capability-pack extends declaration, the branch-family scoped gates, and the optional project block. Exactly one schema version exists; earlier versions fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolchain", "gates"],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "version"],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "The lowercase language identifier, for example go."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
          "description": "The pinned toolchain version, for example 1.26.6."
        }
      }
    },
    "extends": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "description": "Capability pack references in the <capability>@<major> form, for example opentofu@1.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+$"
      }
    },
    "defaults": {
      "$ref": "#/$defs/familyScope"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          },
          "args": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[^\\u0000\\r\\n]*$"
            }
          },
          "timeout": {
            "type": "string",
            "description": "An optional positive Go duration such as 15m."
          },
          "workingDirectory": {
            "type": "string",
            "description": "A path relative to the repository root; never absolute, never escaping."
          },
          "includeFamilies": {
            "$ref": "#/$defs/familyList"
          },
          "excludeFamilies": {
            "$ref": "#/$defs/familyList"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binaries": {
          "type": "array",
          "maxItems": 32,
          "description": "Binary smoke contracts; package paths are unique per document.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package"],
            "properties": {
              "package": {
                "type": "string",
                "pattern": "^\\.?/[A-Za-z0-9_./-]+$"
              },
              "smoke": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "pattern": "^[^\\u0000\\r\\n]*$"
                }
              }
            }
          }
        },
        "fuzz": {
          "type": "array",
          "maxItems": 64,
          "description": "Fuzz lanes; package plus target pairs are unique per document.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "target", "time"],
            "properties": {
              "package": {
                "type": "string",
                "pattern": "^\\.?/[A-Za-z0-9_./-]+$"
              },
              "target": {
                "type": "string",
                "pattern": "^Fuzz[A-Za-z0-9_]*$"
              },
              "time": {
                "type": "string",
                "minLength": 1,
                "description": "A positive Go duration such as 30s or an execution count such as 50000x."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "familyList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
      "$ref": "#/$defs/family"
      }
    },
    "family": {
      "enum": ["main", "develop", "release", "support", "feature", "fix", "docs", "refactor", "chore", "test", "perf", "hotfix", "scratch"]
    },
    "familyScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includeFamilies": {
          "$ref": "#/$defs/familyList"
        },
        "excludeFamilies": {
          "$ref": "#/$defs/familyList"
        }
      }
    }
  }
}
